# Copy this file to .env and fill in the values. .env is in .gitignore and never committed.

# Secret that Claude sends as "Authorization: Bearer <MCP_TOKEN>".
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=

# Main connection (can write). From the Neon dashboard. Must include sslmode=require.
DATABASE_URL=

# Read-only connection as the finance_reader role. Used only by run_query.
READONLY_DATABASE_URL=
