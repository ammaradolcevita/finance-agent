# Copy this file to .env and fill in the values. .env is in .gitignore and never committed.

# Secret that Claude sends as "Authorization: Bearer <MCP_TOKEN>" (at least 32 characters).
# Create it without ever seeing it:  uv run python -m app.admin new-token
MCP_TOKEN=
# Optional, only during a token swap: both tokens work until you remove the old one.
#   uv run python -m app.admin new-token --next
MCP_TOKEN_NEXT=

# Main connection (can write). From Neon: Connect > connection pooling OFF > copy. Must include sslmode=require.
DATABASE_URL=

# Read-only connection as the finance_reader role. Used only by run_query.
# Filled in automatically by: uv run --env-file .env python -m app.admin create-reader
READONLY_DATABASE_URL=

# Time zone for "today" and "this month" (default Europe/Amsterdam).
APP_TIMEZONE=Europe/Amsterdam

# Public host name(s) of the deployed server, comma-separated (empty = local only).
ALLOWED_HOSTS=
